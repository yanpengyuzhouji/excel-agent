# Excel 会话附件服务环境变量模板
# 复制为 .env 并填入真实值：
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env

# DeepSeek API Key（在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：魔搭 Qwen
MODELSCOPE_API_KEY=

# 自定义默认模型，兼容 OpenAI Chat Completions 协议
EXCEL_LLM_BASE_URL=https://api.deepseek.com/v1
EXCEL_LLM_MODEL=deepseek-flash
EXCEL_LLM_API_KEY=
# 开放使用，不需要服务访问凭证。
EXCEL_REQUIRE_AUTH=false
# EXCEL_STORAGE_PATH=/data
