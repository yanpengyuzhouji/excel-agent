# Excel WorkBook Service 环境变量模板
# 复制为 .env 并填入真实值：
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env

RONGNENG_API_KEY=replace-with-a-random-key-at-least-24-chars
RONGNENG_API_PRINCIPAL=default
# RONGNENG_API_KEYS_JSON={"alice":"...long key...","bob":"...long key..."}

# DeepSeek API Key（在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek API Base（一般无需修改）
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 阿里云百炼 OpenAI 兼容接口
BAILIAN_API_KEY=sk-your-bailian-key-here
BAILIAN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
